<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Регистрация</title>
    <style>
        body { font-family: Arial, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; background: #f5f5f5; }
        form { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        input { display: block; margin: 10px 0; padding: 10px; width: 100%; box-sizing: border-box; }
        button { background: #28a745; color: white; border: none; padding: 10px; width: 100%; cursor: pointer; }
        a { text-align: center; display: block; margin-top: 10px; }
        .error { color: red; }
    </style>
</head>
<body>
    <form action="/register" method="post">
        <h2>Регистрация</h2>
        <% if (typeof error !== 'undefined') { %>
            <p class="error"><%= error %></p>
        <% } %>
        <input type="text" name="username" placeholder="Пользователь" required>
        <input type="password" name="password" placeholder="Пароль" required>
        <button type="submit">Зарегистрироваться</button>
        <a href="/login">Вход</a>
    </form>
</body>
</html>
